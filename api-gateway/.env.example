PUERTO=3000

# IMPORTANTE: este JWT_SECRET debe ser EXACTAMENTE el mismo que el de
# ms-autenticacion/.env, porque el Gateway necesita poder validar los
# tokens que ms-autenticacion genero.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

MS_AUTENTICACION_URL=http://localhost:3001
MS_CITAS_URL=http://localhost:3002
